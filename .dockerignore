# Only runtime inputs enter the build context. Build first on the CI runner.
**
!Dockerfile
!package.json
!package-lock.json
!build/
!build/**
!frontend/
!frontend/dist/
!frontend/dist/**
!backend/
!backend/db/
!backend/db/migrations/
!backend/db/migrations/**
!infra/
!infra/deploy/
!infra/deploy/database.mjs
# Private files remain excluded even if accidentally placed beside generated output.
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/*.log
**/*.dump
