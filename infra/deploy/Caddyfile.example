# Gabungkan ke proxy yang sudah ada setelah domain dan konfigurasi VPS diperiksa.
# Ganti domain di bawah, jangan mengganti konfigurasi situs lain.
ceo-stage.egiresources.com {
    @internal path /internal/*
    respond @internal 404
    reverse_proxy 127.0.0.1:4311 {
        flush_interval -1
    }
}
ceo.egiresources.com {
    @internal path /internal/*
    respond @internal 404
    reverse_proxy 127.0.0.1:4312 {
        flush_interval -1
    }
}
