# Stage: 4311; prod: 4312. Port ditetapkan oleh compose.
APP_ORIGIN=https://domain-yang-akan-ditentukan.example
DATABASE_URL=postgresql://ceo_stage_app:REPLACE@127.0.0.1:5432/ceo_voice_agent_stage
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
DEPLOY_CONTROL_TOKEN=REPLACE_WITH_RANDOM_HEX_64_CHARS
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
REGISTRATION_EMAIL_DOMAINS=egiresources.com
SMTP_FROM=
OPENAI_API_KEY=
OPENAI_VOICE_MODEL=gpt-live-1.1
OPENAI_INTENT_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
AI_VOICE_ENABLED=false
AI_VOICE_TEST_HISTORY_ENABLED=true
AI_EMBEDDINGS_ENABLED=false
AI_VOICE_MAX_DURATION_SECONDS=600
AI_OPENAI_BUDGET_USD=6
