{
  "name": "ruang-kerja",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "env:init": "node scripts/init-env.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env --watch --import tsx backend/server.ts",
    "dev:web": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env --import tsx backend/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "db:migrate": "node --env-file-if-exists=.env --import tsx backend/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx backend/db/seed.ts",
    "db:admin": "node --env-file-if-exists=.env --import tsx backend/db/bootstrap-admin.ts",
    "test:backend": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --root . backend --maxWorkers=2",
    "test:frontend": "vitest run --root . frontend",
    "test:tools": "node --import tsx --test scripts/*.test.mjs",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "test:voice:pilot": "node --use-env-proxy --env-file=.env --import tsx scripts/ceo-voice-pilot.mjs",
    "test:voice:fixtures": "node scripts/ceo-voice-pilot-fixtures.mjs",
    "test:voice:luna": "node --use-env-proxy --env-file=.env --import tsx scripts/ceo-voice-luna-pilot.mjs",
    "test:voice:review": "node --use-env-proxy --env-file=.env --import tsx scripts/ceo-voice-pilot-review.mjs",
    "test:voice:protocol": "node --env-file=.env --import tsx scripts/ceo-voice-delegation-smoke.mjs",
    "test:voice:browser-ws": "node --use-env-proxy --env-file=.env --import tsx scripts/ceo-voice-ws-pilot.mjs",
    "voice:history": "node --env-file-if-exists=.env --import tsx scripts/ceo-voice-history.mjs"
  },
  "dependencies": {
    "@fastify/static": "^11.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.7.28",
    "fastify": "^5.12.8",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^1.81.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.6.1",
    "openai": "^7.65.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "node-pg-migrate": {
      "glob": "^14.0.6"
    }
  }
}
